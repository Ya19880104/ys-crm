APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8080

# fresh web installer 在 .env 尚不存在時，必須由 PHP process environment 明示
# INSTALL_HOST=your-domain.example（可含非標準 port，不含 scheme/path）。這是 bootstrap-only
# 部署 anchor，不是 .env application key；Step 2 寫入 APP_URL 後即可從 process env 移除。

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ys_crm
DB_USERNAME=ys_crm
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_PREFIX=ys_crm_

# Session（Zero Trust：閒置/絕對逾時 + 指紋綁定）
SESSION_LIFETIME=7200
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
# UA 綁定預設開；IP 綁定預設關（CDN/反代下 client IP 可能浮動，確認主機穩定轉發 client IP 後再開）
SESSION_BIND_UA=true
SESSION_BIND_IP=false

# 兩階段驗證（2FA / TOTP）
# ADMIN_REQUIRE_2FA：是否強制所有 admin 啟用 2FA（預設 true；設 false 可關閉強制）
ADMIN_REQUIRE_2FA=true
# STEPUP_TTL：敏感操作再認證有效秒數（預設 600 秒 = 10 分鐘）
STEPUP_TTL=600

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=
